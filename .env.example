# HTTP server for CS2 Game State Integration
# For Docker/Unraid this must be 0.0.0.0, not 127.0.0.1.
# Default is 3010 to avoid conflicts with other Unraid services.
GSI_HOST=0.0.0.0
GSI_PORT=3010
GSI_PATH=/gsi

# Shared token set in gamestate_integration_*.cfg (auth.token)
GSI_TOKEN=CHANGE_ME

# MQTT broker
MQTT_HOST=192.168.1.249
MQTT_PORT=1883
MQTT_USERNAME=mqtt
MQTT_PASSWORD=mqtt
MQTT_CLIENT_ID=cs2-led-bridge
MQTT_KEEPALIVE=60
MQTT_RECONNECT_SECONDS=5

# Topics
MQTT_TOPIC_RAW=cs2/raw
MQTT_TOPIC_STATE=cs2/state
MQTT_TOPIC_LED=all
LED_MODE=hud
HUD_CLIENT_ID=cs2-led-hud
HUD_REFRESH_MS=100

# Your LED matrix: 6 modules x 8x8 = 8x48 px.
# With a 5x7 font + 1 spacing column, 8 characters are readable.
HUD_MATRIX_MODULES=6
HUD_FONT_COLUMNS=5
HUD_CHAR_SPACING=1
# Leave 0 for auto. Set to 12 only if your firmware accepts 12 text cells.
HUD_WIDTH_CHARS=0

# Publishing behavior
PUBLISH_RAW=true
PUBLISH_STATE=true
LED_CLEAR_BEFORE=true
LED_CLEAR_AFTER=true
LED_HOLD_SECONDS=8
LED_TIMER_PREFIX=BOMB
LED_WARN_AT_SECONDS=10
BOMB_DURATION_SECONDS=40

# Log verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
