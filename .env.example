# HTTP server for CS2 Game State Integration
# For Docker/Unraid this must be 0.0.0.0, not 127.0.0.1.
# Default is 3010 to avoid conflicts with other Unraid services.
GSI_HOST=0.0.0.0
GSI_PORT=3010
GSI_PATH=/gsi

# Shared token set in gamestate_integration_*.cfg (auth.token)
# Keep CHANGE_ME only for testing. Recommended: set the same token here and in the CS2 GSI config.
GSI_TOKEN=CHANGE_ME

# Used only by install_gsi.py when GSI_HOST=0.0.0.0.
# For Unraid set this to your Unraid/server LAN IP.
UNRAID_HOST=192.168.1.249
# Optional manual CS2 cfg path for install_gsi.py on Windows.
# CS2_CFG_DIR=C:\Program Files (x86)\Steam\steamapps\common\Counter-Strike Global Offensive\game\csgo\cfg

# MQTT broker
MQTT_HOST=192.168.1.249
MQTT_PORT=1883
MQTT_USERNAME=mqtt
MQTT_PASSWORD=mqtt
MQTT_CLIENT_ID=cs2-led-bridge
MQTT_KEEPALIVE=60
MQTT_RECONNECT_SECONDS=5

# Topics
MQTT_TOPIC_RAW=cs2/raw
MQTT_TOPIC_STATE=cs2/state
MQTT_TOPIC_EVENT=cs2/event
MQTT_TOPIC_STATUS=cs2/status
# Old text fallback topic for the current ESP firmware.
MQTT_TOPIC_LED=all
# New graphics/tiles command topic for a smarter ESP renderer.
MQTT_TOPIC_MATRIX_CMD=matrix/cmd
PUBLISH_MATRIX_CMD=true

# LED HUD mode
# Text fallback examples:
#   normal: k:10 d:50
#   damage: h:85 a90
#   bomb timer: boom:34
#   bomb defused: defuse
#   bomb exploded: boom
# New matrix/cmd mode treats the 6 x 8x8 modules as six separate tiles:
#   tile 0 armor bar, tile 1 hp bar, tile 2 ammo bar, tile 3 reserve bar,
#   tile 4 kills, tile 5 deaths.
LED_MODE=hud
HUD_CLIENT_ID=cs2-led-hud
HUD_REFRESH_MS=100
# false = do not blank the matrix just because the status topic briefly says waiting/offline.
# Fresh cs2/state always drives the display.
HUD_CLEAR_ON_OFFLINE=false

# Your LED matrix: 6 modules x 8x8 = 8x48 px.
# With a 5x7 font + 1 spacing column, 8 characters are readable.
HUD_MATRIX_MODULES=6
HUD_FONT_COLUMNS=5
HUD_CHAR_SPACING=1
# Leave 0 for auto. Set to 12 only if your firmware accepts 12 text cells.
HUD_WIDTH_CHARS=0

# Publishing behavior
PUBLISH_RAW=true
PUBLISH_STATE=true
PUBLISH_EVENTS=true
PUBLISH_STATUS=true
STATUS_OFFLINE_AFTER_SECONDS=45
LED_CLEAR_BEFORE=true
LED_CLEAR_AFTER=true
LED_HOLD_SECONDS=8
LED_TIMER_PREFIX=bomb
LED_WARN_AT_SECONDS=10
BOMB_DURATION_SECONDS=40

# Log verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
