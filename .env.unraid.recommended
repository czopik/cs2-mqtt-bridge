# Recommended Unraid config for CS2 MQTT LED Bridge

GSI_HOST=0.0.0.0
GSI_PORT=3010
GSI_PATH=/gsi
GSI_TOKEN=CHANGE_ME
UNRAID_HOST=192.168.1.249

MQTT_HOST=192.168.1.249
MQTT_PORT=1883
MQTT_USERNAME=mqtt
MQTT_PASSWORD=mqtt
MQTT_CLIENT_ID=cs2-led-bridge
MQTT_KEEPALIVE=60
MQTT_RECONNECT_SECONDS=5

MQTT_TOPIC_RAW=cs2/raw
MQTT_TOPIC_STATE=cs2/state
MQTT_TOPIC_EVENT=cs2/event
MQTT_TOPIC_STATUS=cs2/status
MQTT_TOPIC_LED=all

LED_MODE=hud
HUD_CLIENT_ID=cs2-led-hud
HUD_REFRESH_MS=100
HUD_CLEAR_ON_OFFLINE=false

HUD_MATRIX_MODULES=6
HUD_FONT_COLUMNS=5
HUD_CHAR_SPACING=1
HUD_WIDTH_CHARS=0

PUBLISH_RAW=true
PUBLISH_STATE=true
PUBLISH_EVENTS=true
PUBLISH_STATUS=true
STATUS_OFFLINE_AFTER_SECONDS=45

LED_CLEAR_BEFORE=true
LED_CLEAR_AFTER=true
LED_HOLD_SECONDS=8
LED_TIMER_PREFIX=bomb
LED_WARN_AT_SECONDS=10
BOMB_DURATION_SECONDS=40

LOG_LEVEL=INFO
